{
  "elements": [
    {
      "type": "Label",
      "caption": "Verbindung: Das Device erstellt automatisch einen Client Socket als Parent und setzt Host/Port/Open dort."
    },
    {
      "type": "ValidationTextBox",
      "name": "Host",
      "caption": "Host / IP"
    },
    {
      "type": "NumberSpinner",
      "name": "Port",
      "caption": "Port",
      "minimum": 1,
      "maximum": 65535
    },
    {
      "type": "CheckBox",
      "name": "Open",
      "caption": "Socket öffnen"
    },
    {
      "type": "CheckBox",
      "name": "EnableSubscribe",
      "caption": "Subscribe (Push) aktiv"
    },
    {
      "type": "ValidationTextBox",
      "name": "SubscribeFreq",
      "caption": "Subscribe-Frequenz REG (Text, z. B. 0.5)"
    },
    {
      "type": "CheckBox",
      "name": "EnableZoneMute",
      "caption": "Zone Mute aktivieren (Pflicht)"
    },
    {
      "type": "ExpansionPanel",
      "caption": "Metering (DYN Push)",
      "items": [
        {
          "type": "CheckBox",
          "name": "EnableMetering",
          "caption": "Metering via SUBSCRIBE DYN aktivieren"
        },
        {
          "type": "ValidationTextBox",
          "name": "MeteringFreq",
          "caption": "Metering-Frequenz DYN (Text, z. B. 5.0)"
        },
        {
          "type": "ValidationTextBox",
          "name": "MeteringRegex",
          "caption": "Meter-Register Regex (welche DYN Register als Variablen angelegt werden)"
        },
        {
          "type": "NumberSpinner",
          "name": "MeteringMin",
          "caption": "Metering Minimum (Profil) z. B. -80",
          "minimum": -200,
          "maximum": 0
        },
        {
          "type": "NumberSpinner",
          "name": "MeteringMax",
          "caption": "Metering Maximum (Profil) z. B. 0",
          "minimum": -200,
          "maximum": 50
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Input-Filter",
      "items": [
        {
          "type": "CheckBox",
          "name": "IncludeSPDIF",
          "caption": "SPDIF Inputs berücksichtigen"
        },
        {
          "type": "CheckBox",
          "name": "IncludeDante",
          "caption": "Dante Inputs berücksichtigen"
        },
        {
          "type": "CheckBox",
          "name": "IncludeNoise",
          "caption": "Noise Generator berücksichtigen"
        },
        {
          "type": "CheckBox",
          "name": "IncludeMixes",
          "caption": "Mixes berücksichtigen"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "KNX-Taster (optional)",
      "items": [
        {
          "type": "Label",
          "caption": "Pro Zone kann ein KNX-Taster angebunden werden. Ein/Aus = Boolean (an = Zone frei, aus = Zone stumm). Richtung = Boolean (true = lauter, false = leiser). Bewegen = Integer der DPT-3.007-Schrittweite (0 = Stop, 1..7 = Rampe starten). Status % = Integer-Variable, auf die Symcon den aktuellen Pegel zurückmeldet."
        },
        {
          "type": "Label",
          "caption": "--- Zone A ---"
        },
        {
          "type": "SelectVariable",
          "caption": "Zone A Ein/Aus (Boolean)",
          "name": "KnxZoneASwitchVarID"
        },
        {
          "type": "SelectVariable",
          "caption": "Zone A Richtung (Boolean)",
          "name": "KnxZoneADirectionVarID"
        },
        {
          "type": "SelectVariable",
          "caption": "Zone A Bewegen (Integer)",
          "name": "KnxZoneAMoveVarID"
        },
        {
          "type": "SelectVariable",
          "caption": "Zone A Status % (Integer)",
          "name": "KnxZoneAStatusVarID"
        },
        {
          "type": "NumberSpinner",
          "caption": "Zone A Schrittgröße (%)",
          "name": "KnxZoneAStepPercent",
          "minimum": 1,
          "maximum": 20
        },
        {
          "type": "Label",
          "caption": "--- Zone B ---"
        },
        {
          "type": "SelectVariable",
          "caption": "Zone B Ein/Aus (Boolean)",
          "name": "KnxZoneBSwitchVarID"
        },
        {
          "type": "SelectVariable",
          "caption": "Zone B Richtung (Boolean)",
          "name": "KnxZoneBDirectionVarID"
        },
        {
          "type": "SelectVariable",
          "caption": "Zone B Bewegen (Integer)",
          "name": "KnxZoneBMoveVarID"
        },
        {
          "type": "SelectVariable",
          "caption": "Zone B Status % (Integer)",
          "name": "KnxZoneBStatusVarID"
        },
        {
          "type": "NumberSpinner",
          "caption": "Zone B Schrittgröße (%)",
          "name": "KnxZoneBStepPercent",
          "minimum": 1,
          "maximum": 20
        },
        {
          "type": "Label",

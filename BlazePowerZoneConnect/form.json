      "caption": "Polling/Watchdog",
      "items": [
        {
          "type": "NumberSpinner",
          "name": "PollSlow",
          "caption": "PollSlow (Sek.)",
          "minimum": 5
        },
        {
          "type": "NumberSpinner",
          "name": "PollFast",
          "caption": "PollFast (Sek.)",
          "minimum": 2
